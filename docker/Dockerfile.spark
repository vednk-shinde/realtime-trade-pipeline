FROM apache/spark:3.5.3-python3
USER root
RUN pip install --no-cache-dir psycopg2-binary==2.9.10
WORKDIR /app
COPY spark/stream_job.py .
USER spark
ENV HOME=/tmp
CMD ["/opt/spark/bin/spark-submit", \
     "--master", "local[*]", \
     "--driver-memory", "2g", \
     "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3,org.postgresql:postgresql:42.7.4", \
     "--conf", "spark.jars.ivy=/tmp/.ivy", \
     "/app/stream_job.py"]
